+def _systemd_gateway_entrypoint() -> str:
+    """Return the gateway process command for generated systemd units.
+
+    Prefer the installed `hermes` shim (which loads the packaged env via
+    hermes-wrapper), and only fall back to direct python entrypoint when the
+    shim is unavailable (e.g. source checkout or non-packaged installs).
+    """
+    hermes_binary = shutil.which("hermes")
+    if hermes_binary:
+        return shlex.quote(hermes_binary)
+
+    return f"{shlex.quote(get_python_path())} -m hermes_cli.main"
 
 
